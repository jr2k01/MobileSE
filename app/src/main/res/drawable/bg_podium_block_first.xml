<?xml version="1.0" encoding="utf-8"?>
<!--
    Der Block fuer Platz eins. Aufbau wie bei den beiden anderen: ein
    Farbverlauf ueber drei Stufen von oben hell nach unten dunkel gibt dem Block
    Tiefe, statt ihn als flaches Rechteck stehen zu lassen. Nur oben abgerundet,
    damit die drei Bloecke unten auf einer Linie stehen.

    Zwischenzeitlich lag darueber eine zweite Ebene als helle Trittkante. Die
    hatte eigene abgerundete Ecken und setzte deshalb sichtbar versetzt auf dem
    Block auf - der Verlauf allein traegt die Tiefe besser.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/podium_first_light"
        android:centerColor="@color/podium_first"
        android:endColor="@color/podium_first_deep" />
    <corners
        android:topLeftRadius="14dp"
        android:topRightRadius="14dp" />
</shape>
