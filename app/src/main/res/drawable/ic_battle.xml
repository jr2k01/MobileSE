<?xml version="1.0" encoding="utf-8"?>
<!--
    Zwei gekreuzte Klingen fuer den Crew-Battle.

    Je Klinge ein kraeftiger Balken von einer Ecke zur anderen und ein Knauf am
    unteren Ende. Der erste Versuch zeichnete duenne Umrisse mit Spitze und
    Griff - bei 16dp in einer Textzeile blieb davon ein Gekritzel uebrig. Zwei
    klare Formen lesen sich auf jeder Groesse.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurfaceVariant">

    <!-- Klinge von unten links nach oben rechts. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M17.4,3.2L20.8,6.6L6.6,20.8L3.2,17.4Z" />

    <!-- Die gekreuzte Klinge, von unten rechts nach oben links. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M6.6,3.2L20.8,17.4L17.4,20.8L3.2,6.6Z" />

    <!-- Die beiden Knaeufe am unteren Ende. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.4,19.6m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.6,19.6m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0" />
</vector>
