<!--
    Zeichen fuer eine selbst eingetragene Sportart.

    Bewusst neutral - eine Zielscheibe statt eines Geraets: was jemand eintraegt,
    ist nicht vorherzusehen, und jedes konkrete Symbol waere fuer die Haelfte
    der Faelle das falsche.

    Der Ring entsteht wie beim Zahnrad aus zwei Kreisen mit entgegengesetztem
    Umlaufsinn. Der innere beginnt unten: bei einem Bogen gegen den Uhrzeigersinn
    liegt der Mittelpunkt auf der anderen Seite des Startpunkts.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,3.2 A8.8,8.8 0 1,1 11.99,3.2 Z M12,18.6 A6.6,6.6 0 1,0 11.99,18.6 Z" />

    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,7.6 A4.4,4.4 0 1,1 11.99,7.6 Z M12,15.1 A3.1,3.1 0 1,0 11.99,15.1 Z" />

    <path
        android:fillColor="@android:color/white"
