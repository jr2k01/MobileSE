<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine Uhr am Armband: das Gehaeuse als abgerundetes Rechteck, darueber und
    darunter die beiden Bandstuecke, in der Mitte ein Zeiger.

    Von Hand gezeichnet wie die uebrigen Zeichen der App, damit keine weitere
    Symbolbibliothek noetig ist.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurfaceVariant">

    <!-- Die beiden Bandstuecke. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9,1h6v3h-6z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9,20h6v3h-6z" />

    <!-- Gehaeuse als Ring: aussen herum, innen wieder heraus. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7,6m0,2a2,2 0,0 1,2 -2h6a2,2 0,0 1,2 2v8a2,2 0,0 1,-2 2h-6a2,2 0,0 1,-2 -2z
                          M9,8v8h6v-8z" />

    <!-- Der Zeiger: von der Mitte nach oben und nach rechts. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11.4,9h1.2v3h-1.2z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,11.4h2.4v1.2h-2.4z" />
</vector>
