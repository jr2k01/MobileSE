<?xml version="1.0" encoding="utf-8"?>
<!--
    Startbildschirm auf dem Tablet im QUERFORMAT.

    Der Ordner heisst sw600dp-land, nicht sw600dp: im Hochformat soll das
    Tablet dieselbe Anordnung zeigen wie das Telefon, also Leiste unten und
    eine Spalte. Dafuer genuegt es, diese Datei auf das Querformat zu
    beschraenken - dann greift im Hochformat automatisch wieder layout/.

    Quer sind zwei Dinge anders:

    1. Statt der unteren Leiste steht die Navigation als senkrechte Schiene
       (NavigationRailView) am Rand. Das ist die Form, die Material 3 fuer
       breite Bildschirme vorsieht, und quer ist die Hoehe knapp - eine Leiste
       unten wuerde davon noch etwas wegnehmen.

    2. Der Inhalt liegt in zwei Spalten: links Crew und Rangliste, rechts die
       letzten Aktivitaeten. Untereinander bliebe bei 800dp Hoehe und 1280dp
       Breite rechts viel leere Flaeche.

    Beide Fassungen benutzen dieselbe Activity. Die Schiene traegt dieselbe ID
    wie die Leiste, und beide erben von NavigationBarView - der Code fragt nach
    dieser gemeinsamen Oberklasse und muss den Unterschied nicht kennen.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/bottomNav"
        style="@style/Widget.CrewFit.NavRail"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvHomeLogoContainer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivHomeLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_new"
                android:contentDescription="@string/logo_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Wie in layout/: der Name ist zugleich die Crew-Auswahl. -->
        <LinearLayout
            android:id="@+id/llCrewSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toTopOf="@id/cvHomeLogoContainer"
            app:layout_constraintBottom_toBottomOf="@id/cvHomeLogoContainer"
            app:layout_constraintStart_toEndOf="@id/cvHomeLogoContainer"
            app:layout_constraintEnd_toStartOf="@id/btnSearch">

            <TextView
                android:id="@+id/tvHomeCrewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/ivCrewSwitch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/crew_switch_desc"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Muss hier stehen, nicht nur in layout/: die Activity sucht die
             Schaltflaeche in jeder Fassung, und ohne sie waere es kein
             fehlender Knopf, sondern ein Absturz beim Oeffnen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/search_desc"
            app:icon="@drawable/ic_search"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintTop_toTopOf="@id/cvHomeLogoContainer"
            app:layout_constraintBottom_toBottomOf="@id/cvHomeLogoContainer"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Wie im Hochformat: Herunterziehen laedt die Crew neu. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintBottom_toTopOf="@id/btnAllActivities">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <!-- Zwei Spalten nebeneinander, oben ausgerichtet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/members_label" />

                <HorizontalScrollView
                    android:id="@+id/hsvMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llMembersContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <include
                    android:id="@+id/stepsCard"
                    layout="@layout/view_steps_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <!-- Muss hier stehen wie in layout/: die Activity sucht die Karte
                     in jeder Fassung, und ohne sie waere es ein Absturz. -->
                <include
                    android:id="@+id/streakCard"
                    layout="@layout/view_streak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CrewFit.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvRankingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/top_3_label"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <include
                            android:id="@+id/podium"
                            layout="@layout/view_podium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLatestActivitiesLabel"
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/latest_activities_label" />

                <LinearLayout
                    android:id="@+id/llLatestActivitiesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
        Ausserhalb der ScrollView und am unteren Rand verankert, damit er
        sichtbar bleibt, ohne dass gescrollt werden muss. Wie im Hochformat -
        siehe layout/screen_main_hub.xml.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllActivities"
        style="@style/Widget.CrewFit.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/see_all_activities"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
