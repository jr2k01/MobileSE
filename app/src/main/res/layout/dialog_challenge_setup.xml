<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        style="@style/TextAppearance.CrewFit.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/challenge_type_label" />

    <RadioGroup
        android:id="@+id/rgChallengeType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/challenge_type_running"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:checked="true" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbGym"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/challenge_type_gym" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CrewFit.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/challenge_goal_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChallengeGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Freiwillig: ohne Frist laeuft die Challenge weiter wie bisher. Das Feld
        nimmt keine Tastatureingabe entgegen (focusable=false), sondern oeffnet
        den Kalender - ein getipptes Datum muesste sonst geprueft werden und
        koennte in der Vergangenheit liegen.
    -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CrewFit.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/challenge_deadline_hint"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconContentDescription="@string/challenge_deadline_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChallengeDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
