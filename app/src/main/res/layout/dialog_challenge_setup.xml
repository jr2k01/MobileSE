<?xml version="1.0" encoding="utf-8"?>
<!--
    Anlegen einer Team-Challenge: Art, Ziel und eine freiwillige Frist.

    Die Art wird ueber ein Feld gewaehlt, das eine Liste oeffnet, und nicht mehr
    ueber Auswahlknoepfe. Bei zwei Arten passten die noch in den Dialog, bei
    sechs waere er hoeher als der Bildschirm. Dasselbe Muster wie bei der
    Sportart im Workout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CrewFit.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/challenge_type_label"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_drop_down"
        app:endIconContentDescription="@string/challenge_type_choose">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChallengeType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Die Beschriftung nennt die Einheit und wechselt mit der Art. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilChallengeGoal"
        style="@style/Widget.CrewFit.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/challenge_goal_hint_km">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChallengeGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Freiwillig: ohne Frist laeuft die Challenge weiter wie bisher. Das Feld
        nimmt keine Tastatureingabe entgegen (focusable=false), sondern oeffnet
        den Kalender - ein getipptes Datum muesste sonst geprueft werden und
        koennte in der Vergangenheit liegen.
    -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CrewFit.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/challenge_deadline_hint"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconContentDescription="@string/challenge_deadline_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChallengeDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
