<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine offene Battle-Einladung.

    Knapp gehalten: gegen wen, welche Art und welches Ziel - mehr braucht es
    nicht, um zu entscheiden. Der Stand fehlt mit Absicht, denn es gibt noch
    keinen: vor der Annahme zaehlt nichts.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInviteOpponent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvInviteDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvInviteDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!--
            Annehmen und ablehnen fuer den Herausgeforderten, Zuruecknehmen
            fuer den, der eingeladen hat. Es steht immer nur eine der beiden
            Seiten da.
        -->
        <LinearLayout
            android:id="@+id/llInviteAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInviteDecline"
                style="@style/Widget.CrewFit.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battle_decline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInviteAccept"
                style="@style/Widget.CrewFit.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/battle_accept" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInviteWithdraw"
            style="@style/Widget.CrewFit.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/battle_withdraw" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
