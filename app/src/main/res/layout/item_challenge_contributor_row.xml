<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvContributorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <!--
        Der Anteil am Belohnungstopf, der auf diesen Beitrag entfaellt.

        Steht neben dem Beitrag, weil die Regel sonst unsichtbar waere: dass
        neunzig Prozent der Arbeit auch neunzig Prozent der Punkte bringen,
        sieht man erst, wenn beide Zahlen nebeneinanderstehen. Solange das Ziel
        nicht steht, ist es die Aussicht - ausgezahlt wird erst am Ziel.
    -->
    <TextView
        android:id="@+id/tvContributorShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvContributorValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
