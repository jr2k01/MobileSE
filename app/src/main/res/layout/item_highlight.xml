<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine Zeile der Bestwerte: links wovon die Rede ist, rechts der Wert.

    Bewusst kein Diagramm - eine einzelne Zahl als Balken zu zeichnen, an dem
    sich nichts vergleichen laesst, sieht nach Auswertung aus, ohne eine zu
    sein.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/tvHighlightLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvHighlightValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
