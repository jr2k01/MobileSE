<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine laufende Challenge auf dem Startbildschirm.

    Kurzfassung der Zeile aus dem Challenge-Bildschirm: Art, Stand, Balken.
    Ohne die Beitraege der einzelnen Mitglieder und ohne Loeschen-Knopf - das
    steht im Crew-Bildschirm, wo Challenges auch angelegt werden. Hier geht es
    nur darum, im Vorbeigehen zu sehen, wo die Crew steht.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHomeChallengeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvHomeChallengeProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Nur bei einem Battle gegen eine andere Crew. -->
        <TextView
            android:id="@+id/tvHomeChallengeBattle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorError"
            app:drawableStartCompat="@drawable/ic_battle"
            app:drawableTint="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/piHomeChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <!-- Nur bei einer Challenge mit Frist. -->
        <TextView
            android:id="@+id/tvHomeChallengeDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
