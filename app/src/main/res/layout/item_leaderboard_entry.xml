<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:gravity="center" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/leaderboard_avatar_size"
            android:layout_height="@dimen/leaderboard_avatar_size"
            app:cardCornerRadius="@dimen/leaderboard_avatar_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivLeaderboardPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile_desc"
                android:src="@drawable/ic_image" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeaderboardName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <!--
                Woraus die Punkte stammen: Workouts, Challenges, Schritte. Die
                Breiten setzt der Code ueber die Gewichte. Die Rangliste zeigte
                bisher nur die Summe - zwei Mitglieder mit gleichem Stand
                koennen aber voellig verschieden dorthin gekommen sein.
            -->
            <LinearLayout
                android:id="@+id/llPointsSplit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/points_split_height"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vSplitWorkouts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/split_workouts" />

                <View
                    android:id="@+id/vSplitChallenges"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/split_challenges" />

                <View
                    android:id="@+id/vSplitSteps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/split_steps" />

                <!--
                    Der Rest bis zum Fuehrenden, ohne Farbe. Dadurch ist der
                    Balken nicht nur nach Herkunft geteilt, sondern auch so
                    lang wie der Punktestand im Verhaeltnis zur Spitze - sonst
                    saehen 20 und 1835 Punkte gleich breit aus.
                -->
                <View
                    android:id="@+id/vSplitRest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Der Ring zum heutigen Schrittziel, damit die Crew sieht, wer seine
            Schritte schon voll hat. Bei erreichtem Ziel steht in der Mitte ein
            Haken - genau wie auf dem Startbildschirm.
        -->
        <FrameLayout
            android:id="@+id/flStepsGoal"
            android:layout_width="@dimen/leaderboard_steps_column"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/piStepsGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:progress="0"
                app:indicatorColor="?attr/colorSecondary"
                app:indicatorSize="@dimen/leaderboard_ring_size"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />

            <ImageView
                android:id="@+id/ivStepsGoalReached"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="?attr/colorSecondary" />
        </FrameLayout>

        <!--
            Der Chip haelt seine natuerliche Breite - ein fest breiter Chip
            klebte mit seinem Text am linken Rand, weil ein Chip seinen Text
            selbst zeichnet und nicht zentriert. Stattdessen sitzt er mittig in
            einer Spalte fester Breite, damit die Ueberschrift darueber passt.
        -->
        <FrameLayout
            android:layout_width="@dimen/leaderboard_score_column"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <!-- Punktestand als Chip: hebt die Kennzahl ab, ohne eigene Farbe -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tvPoints"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="false"
                android:checkable="false"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:chipStrokeWidth="0dp"
                app:chipMinHeight="32dp" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
