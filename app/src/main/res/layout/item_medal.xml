<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine Medaille im Raster: Bild und darunter der Name.

    Noch nicht verdiente Medaillen stehen abgeblendet mit - so ist zu sehen, was
    es ueberhaupt zu holen gibt, statt nur eine leere Flaeche.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivMedal"
        android:layout_width="@dimen/medal_size"
        android:layout_height="@dimen/medal_size" />

    <TextView
        android:id="@+id/tvMedalName"
        android:layout_width="@dimen/medal_label_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
