<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivActivityPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/take_photo"
            android:background="?attr/colorSurfaceContainerHighest" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nur in der Crew-Ansicht sichtbar: von wem der Eintrag stammt. -->
            <TextView
                android:id="@+id/tvActivityAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvActivitySport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvActivityDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />

            <!-- Dauer als Chip, damit die Kennzahl aus dem Text heraussticht -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tvActivityDuration"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="false"
                android:checkable="false"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:chipStrokeWidth="0dp" />

            <TextView
                android:id="@+id/tvActivityLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_location_on"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <!--
                Kartenausschnitt der Stelle. Nur sichtbar, wenn zu der
                Aktivitaet Koordinaten gespeichert wurden - aeltere Eintraege
                haben keine.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvActivityMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivActivityMap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/map_preview_height"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/location_map_desc" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvActivityMapAttribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:visibility="gone"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
