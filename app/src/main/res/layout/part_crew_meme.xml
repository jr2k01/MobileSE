<?xml version="1.0" encoding="utf-8"?>
<!--
    Das Bild, das die Nummer eins der Crew aufhaengt.

    Steht ganz oben auf dem Ranglisten-Bildschirm, weil sich der Rang hier
    erklaert - wer es sieht, sieht direkt darunter auch, wer gerade fuehrt.

    Drei Zustaende, die der Code umschaltet: ein Bild haengt, es haengt keins
    und man fuehrt selbst (Aufforderung), es haengt keins und man fuehrt nicht
    (blosser Hinweis).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCrewMeme"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:strokeColor="@color/podium_first"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_crown" />

            <TextView
                android:id="@+id/tvMemeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- Nur fuer den Fuehrenden sichtbar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMemeChange"
                style="@style/Widget.CrewFit.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/meme_change"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMemeRemove"
                style="@style/Widget.CrewFit.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/meme_remove"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            Ganz zu sehen, aber nie hoeher als meme_height.

            Vorher stand hier eine feste Hoehe mit centerCrop: das Bild fuellte
            die Flaeche und wurde dafuer an den Raendern abgeschnitten - bei
            einem hochkant aufgenommenen Bild blieb ein Streifen aus der Mitte
            uebrig. Jetzt bestimmt das Bild seine Hoehe selbst (fitCenter,
            adjustViewBounds) und maxHeight deckelt sie. Ein breites Bild
            braucht damit weniger Platz als zuvor, ein hohes hoechstens
            gleich viel.
        -->
        <ImageView
            android:id="@+id/ivCrewMeme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/meme_height"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="?attr/colorSurfaceContainerHighest"
            android:contentDescription="@string/meme_image_desc"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMemeCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Steht statt des Bildes da, solange keins haengt -->
        <TextView
            android:id="@+id/tvMemeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
