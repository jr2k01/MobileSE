<?xml version="1.0" encoding="utf-8"?>
<!--
    Die Anforderungen an das Passwort, die sich beim Tippen abhaken.

    Steht hier einmal, weil zwei Bildschirme sie brauchen: die Registrierung und
    das Neusetzen des Passworts nach dem Link aus der Mail. Die Regeln muessen
    an beiden Stellen dieselben sein - sie kommen ohnehin aus [PasswordPolicy],
    aber auch die Darstellung soll sich nicht auseinanderentwickeln.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CrewFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

    <LinearLayout
        android:id="@+id/llPasswordRules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPasswordRulesTitle"
            style="@style/TextAppearance.CrewFit.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pw_requirements_title" />

        <TextView
            android:id="@+id/tvRuleLength"
            style="@style/PasswordRule" />

        <TextView
            android:id="@+id/tvRuleUppercase"
            style="@style/PasswordRule" />

        <TextView
            android:id="@+id/tvRuleLowercase"
            style="@style/PasswordRule" />

        <TextView
            android:id="@+id/tvRuleDigit"
            style="@style/PasswordRule" />

        <TextView
            android:id="@+id/tvRuleSpecial"
            style="@style/PasswordRule" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
