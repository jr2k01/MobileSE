<?xml version="1.0" encoding="utf-8"?>
<!--
    Ein Zeichen mit seiner Zahl.

    Wird je Eintrag aus Reactions.ALL einmal aufgeblasen statt fuenfmal im
    Bildschirmlayout zu stehen - ein sechstes Zeichen dort soll nichts weiter
    erfordern als den Eintrag selbst.

    Die eigene Wahl faerbt die Activity ein; hier steht der schlichte Zustand.
-->
<com.google.android.material.button.MaterialButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialButtonOutlinedStyle"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:minWidth="0dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    app:cornerRadius="22dp" />
