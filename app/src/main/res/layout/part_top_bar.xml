<?xml version="1.0" encoding="utf-8"?>
<!--
    Gemeinsame Kopfzeile der Unterseiten: Zurueck-Pfeil und Titel.

    Vorher hatte jeder Bildschirm seine eigene Fassung davon, mit leicht
    abweichenden Abstaenden und Schriftgroessen. Als eingebundenes Teillayout
    sind sie garantiert gleich - der Titel wird in der Activity gesetzt.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/top_bar_padding_top"
    android:paddingBottom="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTopBarBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/back_desc"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Platz fuer eine Aktion rechts, etwa das Zahnrad im Profil. Standardmaessig
        weg: die meisten Unterseiten haben keine.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTopBarAction"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="@id/btnTopBarBack"
        app:layout_constraintBottom_toBottomOf="@id/btnTopBarBack"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Platz fuer ein Bild links vom Titel, etwa das eigene Profilbild im
        "Me"-Reiter. Wie die Aktion rechts standardmaessig weg - die meisten
        Unterseiten zeigen einen Titel und sonst nichts.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvTopBarAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="?attr/colorPrimaryContainer"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:layout_constraintBottom_toBottomOf="@id/btnTopBarBack"
        app:layout_constraintStart_toEndOf="@id/btnTopBarBack"
        app:layout_constraintTop_toTopOf="@id/btnTopBarBack">

        <!--
            Ohne app:tint. Die Faerbung bliebe auf dem geladenen Foto liegen und
            machte aus ihm eine einfarbige Flaeche - genau das war beim ersten
            Versuch auf dem Tablet zu sehen. Dieselbe Bauart wie die
            Mitglieder-Kreise im Startbildschirm.
        -->
        <ImageView
            android:id="@+id/ivTopBarAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/profile_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTopBarTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/btnTopBarBack"
        app:layout_constraintEnd_toStartOf="@id/btnTopBarAction"
        app:layout_constraintStart_toEndOf="@id/cvTopBarAvatar"
        app:layout_constraintTop_toTopOf="@id/btnTopBarBack" />
</androidx.constraintlayout.widget.ConstraintLayout>
