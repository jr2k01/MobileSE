<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvCrewNameDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceDisplaySmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- QR-Code zum Teilen der Crew -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCrewCodeSection"
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crew_qr_code" />

                    <!-- Weisser Grund, damit der Code lesbar bleibt -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/qr_code_size"
                        android:layout_height="@dimen/qr_code_size"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/ivOverviewQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/crew_qr_code"
                            android:padding="14dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manual_code_label"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="20dp" />

                    <TextView
                        android:id="@+id/tvOverviewCrewCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorPrimary"
                        android:letterSpacing="0.15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMembersLabel"
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/members_caps"
                android:layout_marginTop="32dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <!--
                    Frueher ein einzelner Textblock mit allen Namen. Jetzt eine
                    Zeile je Mitglied, weil man von hier aus auf das Profil
                    kommen soll - und mit Bild ist die Liste ohnehin besser zu
                    lesen.
                -->
                <LinearLayout
                    android:id="@+id/llMembersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaveCrew"
                style="@style/Widget.CrewFit.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/leave_crew"
                android:textColor="?attr/colorError"
                android:layout_marginTop="28dp" />

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
