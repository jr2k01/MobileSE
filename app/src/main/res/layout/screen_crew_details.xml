<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="32dp">

            <!--
                Das Bild der Crew, aufgebaut wie das Profilbild: gleiche
                Groesse, gleicher Rand, angetippt waehlt man ein neues. Nur der
                Gruender darf es aendern, deshalb setzt die Activity das
                Antippen auch nur fuer ihn.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCrewImage"
                android:layout_width="@dimen/profile_photo_size"
                android:layout_height="@dimen/profile_photo_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="@dimen/profile_photo_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <ImageView
                    android:id="@+id/ivCrewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/crew_image_desc"
                    android:src="@drawable/ic_group" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvCrewImageHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/crew_image_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvCrewNameDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceDisplaySmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- QR-Code zum Teilen der Crew -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCrewCodeSection"
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crew_qr_code" />

                    <!-- Weisser Grund, damit der Code lesbar bleibt -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/qr_code_size"
                        android:layout_height="@dimen/qr_code_size"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/ivOverviewQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/crew_qr_code"
                            android:padding="14dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manual_code_label"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="20dp" />

                    <TextView
                        android:id="@+id/tvOverviewCrewCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorPrimary"
                        android:letterSpacing="0.15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMembersLabel"
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/members_caps"
                android:layout_marginTop="32dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <!--
                    Frueher ein einzelner Textblock mit allen Namen. Jetzt eine
                    Zeile je Mitglied, weil man von hier aus auf das Profil
                    kommen soll - und mit Bild ist die Liste ohnehin besser zu
                    lesen.
                -->
                <LinearLayout
                    android:id="@+id/llMembersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <!--
                Offene Beitrittsanfragen. Nur der Gruender sieht diesen
                Abschnitt, und auch er nur, solange etwas offen ist - eine
                dauerhaft leere Ueberschrift waere ein Versprechen auf etwas,
                das nie kommt. Die Activity blendet beides zusammen ein.
            -->
            <TextView
                android:id="@+id/tvJoinRequestsLabel"
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/join_requests_caps"
                android:layout_marginTop="32dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvJoinRequests"
                style="@style/Widget.CrewFit.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/llJoinRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Statt eines verschwundenen Abschnitts: der Platz
                         bleibt, und es steht dabei, was hier erscheinen wird. -->
                    <TextView
                        android:id="@+id/tvJoinRequestsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/join_requests_empty"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaveCrew"
                style="@style/Widget.CrewFit.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/leave_crew"
                android:textColor="?attr/colorError"
                android:layout_marginTop="28dp" />

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
