<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Die Crew-Challenges haben einen eigenen Bildschirm, erreichbar ueber
         die Navigationsleiste: siehe screen_crew_challenges.xml -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/crewCharts"
                layout="@layout/part_crew_charts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/rank_header" />

                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="60dp"
                    android:text="@string/member_header" />

                <!--
                    Feste Breite, dieselbe wie die Ringspalte in
                    item_leaderboard_entry - nur so steht das Wort ueber dem
                    Kreis und nicht daneben.
                -->
                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="@dimen/leaderboard_steps_column"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/steps_header" />

                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="@dimen/leaderboard_score_column"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/score_header" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLeaderboardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
