<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Umschalter zwischen Rangliste und Auswertung. Derselbe Aufbau wie ueber
        der Aktivitaetenliste (screen_workout_history.xml), damit ein Umschalter
        in dieser App ueberall gleich aussieht.

        Beides stand vorher untereinander auf einem Bildschirm: bis zur
        Rangliste - dem, weswegen man den Bildschirm oeffnet - waren drei
        Karten wegzuscrollen.
    -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgLeaderboardTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabRanking"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/tab_ranking" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabAnalytics"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/tab_analytics" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Die Crew-Challenges haben einen eigenen Bildschirm, erreichbar ueber
         die Navigationsleiste: siehe screen_crew_challenges.xml -->
    <ScrollView
        android:id="@+id/svLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tgLeaderboardTab"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="24dp">

            <!-- === Rangliste: Bild der Nummer eins und die Tabelle === -->
            <LinearLayout
                android:id="@+id/llRankingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/crewMeme"
                    layout="@layout/part_crew_meme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/rank_header" />

                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="60dp"
                        android:text="@string/member_header" />

                    <!--
                        Feste Breite, dieselbe wie die Ringspalte in
                        item_leaderboard_entry - nur so steht das Wort ueber dem
                        Kreis und nicht daneben.
                    -->
                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="@dimen/leaderboard_steps_column"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/steps_header" />

                    <TextView
                        style="@style/TextAppearance.CrewFit.SectionLabel"
                        android:layout_width="@dimen/leaderboard_score_column"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/score_header" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLeaderboardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- === Auswertung === -->
            <LinearLayout
                android:id="@+id/llAnalyticsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/crewCharts"
                    layout="@layout/part_crew_charts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
