<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Kopfbereich: Logo, Crew und Uhrzeit -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="56dp"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            Senkrecht am Crew-Namen ausgerichtet, nicht umgekehrt.

            Vorher hing der Name am Logo - oben und unten. Ein Name, der auf
            zwei Zeilen umbricht, wurde damit auf die 44dp des Logos
            zusammengedrueckt, und die Oberkante der Buchstaben war
            abgeschnitten. Jetzt bestimmt der Text die Hoehe, und das Logo
            sitzt mittig daneben.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvHomeLogoContainer"
            android:layout_width="@dimen/logo_size_small"
            android:layout_height="@dimen/logo_size_small"
            app:cardCornerRadius="@dimen/logo_radius_small"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/llCrewSwitch"
            app:layout_constraintBottom_toBottomOf="@id/llCrewSwitch"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivHomeLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_new"
                android:contentDescription="@string/logo_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!--
            Neben dem Logo mittig, seit die Uhrzeit darunter entfallen ist.

            Antippbar, weil hier die Crew gewechselt wird: der Name ist das,
            was die gerade angezeigte Crew benennt, also gehoert die Auswahl an
            dieselbe Stelle. Der Pfeil sagt, dass da etwas aufgeht - ohne ihn
            waere es eine Ueberschrift, die zufaellig reagiert.
        -->
        <LinearLayout
            android:id="@+id/llCrewSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="@dimen/logo_size_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvHomeLogoContainer"
            app:layout_constraintEnd_toStartOf="@id/btnSearch">

            <TextView
                android:id="@+id/tvHomeCrewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/ivCrewSwitch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/crew_switch_desc"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!--
            Die Suche nach Leuten und Crews. Hier oben, weil sie der Weg nach
            draussen ist - alles andere auf diesem Bildschirm zeigt die eigene
            Crew. Die Einstellungen sind ins Profil gewandert; sie gehoeren zur
            eigenen Person und nicht zur Crew.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/search_desc"
            app:icon="@drawable/ic_search"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintTop_toTopOf="@id/llCrewSwitch"
            app:layout_constraintBottom_toBottomOf="@id/llCrewSwitch"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Herunterziehen laedt die Crew neu; siehe PullToRefresh.kt. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintBottom_toTopOf="@id/btnAllActivities">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/members_label" />

            <HorizontalScrollView
                android:id="@+id/hsvMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llMembersContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <include
                android:id="@+id/stepsCard"
                layout="@layout/view_steps_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <include
                android:id="@+id/streakCard"
                layout="@layout/view_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Ueber allem anderen ausser Schritten und Serie: es ist das
                 einzige hier, das auf eine Handlung wartet. -->
            <include
                android:id="@+id/pendingWorkoutCard"
                layout="@layout/view_pending_workout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!--
                Laufende Challenges.

                Stehen hier, seit der eigene Reiter dafuer weg ist: Challenges
                sind das, was gerade laeuft, und gehoeren dorthin, wo man
                ohnehin jeden Tag hinsieht. Ueberschrift und Liste werden
                zusammen ein- und ausgeblendet - eine Ueberschrift ohne
                Challenge waere ein Versprechen auf etwas, das nicht da ist.
                Angelegt werden sie im Crew-Bildschirm.
            -->
            <TextView
                android:id="@+id/tvHomeChallengesLabel"
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="28dp"
                android:text="@string/home_challenges_label" />

            <LinearLayout
                android:id="@+id/llHomeChallenges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- Top 3 der Crew -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvRankingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/top_3_label"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include
                        android:id="@+id/podium"
                        layout="@layout/view_podium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvLatestActivitiesLabel"
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/latest_activities_label" />

            <LinearLayout
                android:id="@+id/llLatestActivitiesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
        Steht ausserhalb der ScrollView und ist an der Navigationsleiste
        verankert, damit er immer sichtbar bleibt. Vorher stand er am Ende der
        Liste - wer die letzten Aktivitaeten sah, musste erst an ihnen vorbei
        scrollen, um zu allen zu gelangen.

        Nachrangige Aktion: umrandet statt gefuellt, damit sie die Liste
        darueber nicht ueberstrahlt.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllActivities"
        style="@style/Widget.CrewFit.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/see_all_activities"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.CrewFit.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
