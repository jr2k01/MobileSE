<?xml version="1.0" encoding="utf-8"?>
<!--
    Kurzer Ueberblick ueber ein Crewmitglied: Bild, Kuerzel, ein paar Kennzahlen
    und die gesammelten Medaillen.

    Bewusst nur, was die Crew angeht. Geburtsdatum, Groesse und Gewicht stehen
    im eigenen Profil und bleiben dort - sie gehen niemanden sonst etwas an.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/ContentColumn"
                android:paddingBottom="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/profile_photo_size"
                    android:layout_height="@dimen/profile_photo_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="@dimen/profile_photo_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="?attr/colorPrimaryContainer"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                    <ImageView
                        android:id="@+id/ivMemberPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile_desc"
                        android:src="@drawable/ic_image" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvMemberName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Schritte von heute, wie in der Rangliste -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/piStepsGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="false"
                            android:progress="0"
                            app:indicatorColor="?attr/colorSecondary"
                            app:indicatorSize="@dimen/leaderboard_ring_size"
                            app:trackColor="?attr/colorSurfaceContainerHighest"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="3dp" />

                        <ImageView
                            android:id="@+id/ivStepsGoalReached"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check"
                            android:visibility="gone"
                            app:tint="?attr/colorSecondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMemberSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Drei Kennzahlen nebeneinander -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statPoints"
                        layout="@layout/part_member_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statWorkouts"
                        layout="@layout/part_member_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp" />

                    <include
                        android:id="@+id/statMedals"
                        layout="@layout/part_member_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.CrewFit.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/medals_label" />

                <GridLayout
                    android:id="@+id/glMedals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="@integer/medal_columns" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
