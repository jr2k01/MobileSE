<?xml version="1.0" encoding="utf-8"?>
<!--
    Die Einstellungen, erreichbar ueber das Zahnrad auf dem Startbildschirm.

    Hier steht, was die App betrifft und nicht das Profil: der Zugriff auf die
    Schrittzahl und das Konto. Abmelden und Loeschen standen vorher unter dem
    Profilformular - an einer Stelle, an der man sie nur findet, wenn man
    ohnehin gerade seine Groesse aendert.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            style="@style/ContentColumn"
            android:paddingBottom="24dp">

            <!--
                === Profil ===

                Ganz oben und in einer eigenen Karte: seit die untere Leiste
                hierher fuehrt statt direkt ins Profil, ist das der Weg zu
                allem Persoenlichen - Name, Bild, Geburtsdatum, Groesse,
                Gewicht. Der Eintrag traegt die eigene Mailadresse, damit auf
                einen Blick klar ist, um wessen Profil es geht.
            -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_profile_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:id="@+id/llSettingsProfile"
                    style="@style/Widget.CrewFit.SettingsRow"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_profile"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                    <TextView
                        android:id="@+id/tvSettingsEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Erscheinungsbild === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_appearance_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:id="@+id/llTheme"
                    style="@style/Widget.CrewFit.SettingsRow"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                    <!-- Zeigt die aktuelle Wahl, damit man sie nicht erst
                         antippen muss, um sie zu sehen. -->
                    <TextView
                        android:id="@+id/tvThemeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Benachrichtigungen === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_notifications_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:id="@+id/llNotifications"
                    style="@style/Widget.CrewFit.SettingsRow"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                    <!-- Ob sie ankommen, entscheidet das System; der Text sagt,
                         woran man gerade ist. -->
                    <TextView
                        android:id="@+id/tvNotificationsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Sichtbarkeit === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_privacy_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <!--
                    Hier steht ausnahmsweise ein Schalter und keine Zeile, die
                    weiterfuehrt: anders als bei den Berechtigungen entscheidet
                    darueber die App selbst, nicht das System.
                -->
                <LinearLayout
                    android:id="@+id/llVisibility"
                    style="@style/Widget.CrewFit.SettingsRow"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_visibility"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                        <TextView
                            android:id="@+id/tvVisibilityStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVisibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/settings_visibility" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Berechtigungen === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_permissions_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <!--
                    Leer im Layout: die Zeilen kommen aus AppPermission und
                    werden in der Activity eingehaengt. Was die App anfragt,
                    steht damit an einer Stelle statt an zweien.
                -->
                <LinearLayout
                    android:id="@+id/llPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- === Schritte === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_steps_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/llHealthConnect"
                        style="@style/Widget.CrewFit.SettingsRow">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_health_connect"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                        <!-- Der Text sagt, woran man gerade ist; gesetzt wird er
                             im Code, weil er vom Geraet abhaengt. -->
                        <TextView
                            android:id="@+id/tvHealthConnectStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llStepsPrivacy"
                        style="@style/Widget.CrewFit.SettingsRow">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_steps_privacy"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_steps_privacy_hint"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Konto === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_account_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/llLogout"
                        style="@style/Widget.CrewFit.SettingsRow">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/logout_btn"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llDeleteProfile"
                        style="@style/Widget.CrewFit.SettingsRow">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/delete_profile_btn"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle"
                            android:textColor="?attr/colorError" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_delete_hint"
                            android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === Ueber die App === -->
            <TextView
                style="@style/TextAppearance.CrewFit.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_about_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CrewFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.CrewFit.Small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsTitle" />

                    <TextView
                        android:id="@+id/tvSettingsVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.CrewFit.SettingsSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
