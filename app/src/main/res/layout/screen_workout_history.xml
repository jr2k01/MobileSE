<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Notch Puffer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="48dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackActivities"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_desc"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_main" />

        <TextView
            android:id="@+id/tvActivitiesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/latest_activities_label"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            app:layout_constraintTop_toTopOf="@id/btnBackActivities"
            app:layout_constraintBottom_toBottomOf="@id/btnBackActivities"
            app:layout_constraintStart_toEndOf="@id/btnBackActivities"
            android:layout_marginStart="8dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
        Umschalter zwischen den eigenen Aktivitaeten und denen der ganzen
        Crew. MaterialButtonToggleGroup gehoert zur bereits eingebundenen
        Material-Bibliothek und sorgt selbst dafuer, dass immer genau eine
        Schaltflaeche ausgewaehlt ist.
    -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgActivityScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/clTop">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScopeMine"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/scope_mine"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            app:strokeColor="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScopeCrew"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/scope_crew"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            app:strokeColor="@color/divider" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tgActivityScope"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llActivitiesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
