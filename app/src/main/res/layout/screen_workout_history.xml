<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Umschalter zwischen den eigenen Aktivitaeten und denen der ganzen
        Crew. MaterialButtonToggleGroup gehoert zur bereits eingebundenen
        Material-Bibliothek und sorgt selbst dafuer, dass immer genau eine
        Schaltflaeche ausgewaehlt ist.
    -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgActivityScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScopeMine"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/scope_mine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScopeCrew"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/scope_crew" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tgActivityScope"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llActivitiesContainer"
                style="@style/ContentColumn"
                android:paddingBottom="24dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
