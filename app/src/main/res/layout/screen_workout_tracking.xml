<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--
        Dieselbe Kopfzeile wie auf allen anderen Unterseiten. Vorher trug der
        Bildschirm nur eine grosse Ueberschrift, und zurueck kam man allein
        ueber "Abbrechen" ganz unten - man musste also erst durch das ganze
        Formular scrollen. Ausserhalb der ScrollView bleibt der Pfeil stehen.
    -->
    <include
        android:id="@+id/topBar"
        layout="@layout/part_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

    <!-- ContentColumnWrapper: haelt die volle Breite, damit die
         Inhaltsspalte darin zentriert begrenzt werden kann. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingTop="8dp"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="32dp">

        <!--
            Kein ExposedDropdownMenu mehr: dessen Popup oeffnete sich zwar in
            richtiger Groesse, zeichnete aber nichts und nahm keine Beruehrungen
            an - die Liste war unsichtbar und unbedienbar. Fuer sechs feste
            Eintraege genuegt ein Auswahldialog, der ohne eigenes Popup-Fenster
            auskommt. Das Feld selbst ist nur noch Anzeige und Schaltflaeche.
        -->
        <!--
            Der Hinweis auf das Workout, das von der Uhr kam.

            Steht ueber dem Formular und nicht daneben: Sportart und Dauer sind
            schon ausgefuellt, und ohne eine Zeile davor waere unklar, woher
            die Werte kommen und warum man sie aendern darf.

            Ist meistens gone. In einem ConstraintLayout schrumpft ein solcher
            Block auf einen Punkt zusammen, das Feld darunter rueckt also nach
            oben - eine eigene Fassung des Bildschirms braucht es dafuer nicht.
        -->
        <TextView
            android:id="@+id/tvWatchNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_watch_notice"
            android:drawablePadding="10dp"
            android:padding="12dp"
            app:drawableStartCompat="@drawable/ic_watch"
            app:drawableTint="?attr/colorOnTertiaryContainer"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            Dass dieses Workout doppelt zaehlt. Dieselbe Form wie der Hinweis
            auf ein Workout von der Uhr - beides sagt "hier ist etwas anders
            als sonst", und zwei verschiedene Formen dafuer waeren eine zuviel.

            Unsichtbar, solange allein trainiert wird; ConstraintLayout zieht
            den Block dann auf einen Punkt zusammen und das Feld darunter
            rueckt nach oben.
        -->
        <TextView
            android:id="@+id/tvPartnerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_watch_notice"
            android:drawablePadding="10dp"
            android:padding="12dp"
            app:drawableStartCompat="@drawable/ic_group"
            app:drawableTint="?attr/colorOnTertiaryContainer"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:layout_constraintTop_toBottomOf="@id/tvWatchNotice" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSport"
            style="@style/Widget.CrewFit.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/train_question"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvPartnerBanner">

            <!--
                focusable=false: das Feld wird nicht getippt, sondern
                angetippt. So oeffnet der Klick zuverlaessig den Dialog,
                statt die Tastatur einzublenden.
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDuration"
            style="@style/Widget.CrewFit.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/duration_hint"
            app:layout_constraintTop_toBottomOf="@id/tilSport">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDistance"
            style="@style/Widget.CrewFit.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/distance_hint"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tilDuration">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Foto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPhoto"
            style="@style/Widget.CrewFit.Card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/photo_card_height"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilDistance">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!--
                    centerInside, damit das Platzhalter-Symbol klein in der
                    Mitte steht statt auf Kartengroesse gezogen zu werden.
                    Sobald ein Foto da ist, stellt die Activity auf
                    centerCrop um und das Bild fuellt die Karte.
                -->
                <ImageView
                    android:id="@+id/ivWorkoutPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_photo_camera"
                    android:padding="86dp"
                    android:alpha="0.25"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/take_photo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    style="@style/Widget.CrewFit.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/take_photo"
                    app:icon="@drawable/ic_photo_camera"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sprachnotiz -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVoice"
            style="@style/Widget.CrewFit.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/cvPhoto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/ivVoiceStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="@string/record_voice"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/record_voice"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecordVoice"
                    style="@style/Widget.CrewFit.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_short"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Standort -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLocation"
            style="@style/Widget.CrewFit.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/cvVoice">

            <!--
                MaterialCardView ist ein FrameLayout und stapelt mehrere
                Kinder uebereinander. Standortzeile und Kartenvorschau stehen
                deshalb gemeinsam in diesem senkrechten Container.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location_on"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/gps_btn" />

                    <TextView
                        android:id="@+id/tvLocationStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/location_not_shared"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetLocation"
                        style="@style/Widget.CrewFit.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_btn" />
                </LinearLayout>

                <!--
                    Kartenvorschau des gewaehlten Ortes. Bleibt ausgeblendet,
                    solange kein Standort feststeht.
                -->
                <LinearLayout
                    android:id="@+id/llMapPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivLocationMap"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/location_map_desc" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvMapAttribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveActivity"
            style="@style/Widget.CrewFit.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/save_workout"
            app:layout_constraintTop_toBottomOf="@id/cvLocation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAdd"
            style="@style/Widget.CrewFit.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cancel_btn"
            android:textColor="?attr/colorError"
            app:layout_constraintTop_toBottomOf="@id/btnSaveActivity" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
