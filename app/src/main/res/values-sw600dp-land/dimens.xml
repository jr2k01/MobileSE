<!--
    Tablet im Querformat: viel Breite, wenig Hoehe.

    Die Inhaltsbreite darf etwas groesser sein als im Hochformat, weil daneben
    die Navigationsleiste als senkrechte Schiene steht. Die Hoehe wird wie beim
    Telefon im Querformat gespart.
-->
<resources>
    <dimen name="screen_padding_horizontal">40dp</dimen>
    <dimen name="content_max_width">700dp</dimen>
    <dimen name="top_bar_padding_top">28dp</dimen>
    <dimen name="profile_photo_size">104dp</dimen>
    <dimen name="photo_card_height">220dp</dimen>
    <dimen name="map_preview_height">180dp</dimen>
</resources>
