<?xml version="1.0" encoding="utf-8"?>
<!--
    Tablet im Querformat: viel Breite, wenig Hoehe.

    Hier greift die Begrenzung der Inhaltsbreite. Der Startbildschirm hat quer
    ein eigenes Layout mit zwei Spalten, die uebrigen Bildschirme wuerden ihre
    Zeilen sonst ueber die vollen 1280dp ziehen.

    Alles, was vor allem Hoehe kostet, faellt kleiner aus als im Hochformat.
-->
<resources>
    <dimen name="content_max_width">760dp</dimen>
    <dimen name="top_bar_padding_top">28dp</dimen>

    <dimen name="profile_photo_size">120dp</dimen>
    <dimen name="profile_photo_radius">60dp</dimen>
    <dimen name="logo_size_large">104dp</dimen>
    <dimen name="logo_size_medium">72dp</dimen>

    <dimen name="photo_card_height">240dp</dimen>
    <dimen name="activity_photo_height">220dp</dimen>
    <dimen name="map_preview_height">190dp</dimen>

    <!--
        Auch hier gilt: was vor allem Hoehe kostet, faellt kleiner aus als im
        Hochformat. Die Wochenbalken und der Sportring stehen sonst so hoch,
        dass unter ihnen nichts mehr ins Bild passt.
    -->
    <dimen name="meme_height">220dp</dimen>
    <dimen name="chart_week_height">112dp</dimen>
    <dimen name="donut_size">124dp</dimen>
    <dimen name="donut_ring_width">22dp</dimen>
</resources>
