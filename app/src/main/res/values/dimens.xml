<?xml version="1.0" encoding="utf-8"?>
<!--
    Masse fuer Raender, Abstaende und Bildgroessen, an einer Stelle.

    Der Sinn: dieselben Layouts liegen auf Telefon und Tablet, nur diese Werte
    unterscheiden sich. So braucht es nicht fuer jeden Bildschirm eine zweite
    Layoutdatei, die man bei jeder Aenderung doppelt pflegen muesste.

    Die Tablet-Werte stehen in values-sw600dp, die Querformat-Werte in
    values-land und values-sw600dp-land. "sw600dp" meint die kuerzere
    Bildschirmkante: sie aendert sich beim Drehen nicht, ein Tablet bleibt also
    in beiden Lagen ein Tablet.
-->
<resources>

    <!-- Seitenrand des Bildschirminhalts -->
    <dimen name="screen_padding_horizontal">20dp</dimen>

    <!--
        Groesste Breite, die ein Textblock oder Formular einnehmen darf.
        Auf Telefon und Tablet im Hochformat liegt der Wert ueber der
        Bildschirmbreite, wirkt also nicht - der Inhalt nutzt die volle
        Flaeche. Begrenzt wird nur im Querformat, wo sonst ueber tausend dp
        breite Zeilen entstuenden.
    -->
    <dimen name="content_max_width">2000dp</dimen>

    <!-- Kopfbereich der Unterseiten -->
    <dimen name="top_bar_padding_top">52dp</dimen>

    <!-- Innenabstand in Karten -->
    <dimen name="card_padding">20dp</dimen>

    <!-- Profilbild auf dem Profilbildschirm -->
    <dimen name="profile_photo_size">112dp</dimen>
    <dimen name="profile_photo_radius">56dp</dimen>

    <!-- Logo auf den Anmeldebildschirmen und im Kopf des Startbildschirms -->
    <dimen name="logo_size_large">112dp</dimen>
    <dimen name="logo_size_medium">72dp</dimen>
    <dimen name="logo_size_small">44dp</dimen>
    <dimen name="logo_radius_small">22dp</dimen>

    <!-- Mitgliederbild in der Leiste auf dem Startbildschirm -->
    <dimen name="member_avatar_size">60dp</dimen>
    <dimen name="member_avatar_radius">30dp</dimen>

    <!-- Bild in einer Ranglistenzeile -->
    <dimen name="leaderboard_avatar_size">40dp</dimen>
    <dimen name="leaderboard_avatar_radius">20dp</dimen>

    <!-- QR-Code der Crew -->
    <dimen name="qr_code_size">196dp</dimen>

    <!-- Hoehe der Fotovorschau beim Eintragen eines Workouts -->
    <dimen name="photo_card_height">220dp</dimen>

    <!-- Foto in der Aktivitaetenliste -->
    <dimen name="activity_photo_height">200dp</dimen>

    <!-- Kartenausschnitt in der Aktivitaetenliste -->
    <dimen name="map_preview_height">140dp</dimen>

    <!--
        Podest der Crew Top 3. Der erste Platz ist bewusst groesser als die
        beiden anderen - so ist auf einen Blick klar, wer vorne liegt, auch
        ohne die Ziffern zu lesen.
    -->
    <dimen name="podium_avatar_size">44dp</dimen>
    <dimen name="podium_avatar_radius">22dp</dimen>
    <dimen name="podium_avatar_size_first">54dp</dimen>
    <dimen name="podium_avatar_radius_first">27dp</dimen>
    <dimen name="podium_block_first_height">58dp</dimen>
    <dimen name="podium_block_second_height">42dp</dimen>
    <dimen name="podium_block_third_height">32dp</dimen>
    <!-- Der Schein liegt hinter dem Bild und muss deutlich groesser sein. -->
    <dimen name="podium_glow_size">82dp</dimen>
    <dimen name="podium_crown_size">20dp</dimen>
    <!-- Abstand zwischen Bild und Block; klein, damit die Saeule nicht wandert. -->
    <dimen name="podium_avatar_gap">6dp</dimen>

    <!-- Ring zum Tagesziel neben der Schrittzahl -->
    <dimen name="steps_goal_ring_size">34dp</dimen>
    <!-- Derselbe Ring in der Ranglistenzeile, wo weniger Platz ist -->
    <dimen name="leaderboard_ring_size">28dp</dimen>
    <!--
        Breite der Ringspalte. Richtet sich nach der Ueberschrift "STEPS", nicht
        nach dem Ring - der Ring wird darin mittig gesetzt. Kopfzeile und Zeile
        benutzen denselben Wert, damit die Beschriftung ueber dem Kreis steht.
    -->
    <dimen name="leaderboard_steps_column">62dp</dimen>
    <!--
        Auch die Punktespalte steht fest. Sonst richtet sich die Ringspalte nach
        der Breite des Chips - und die haengt an der Punktzahl, sodass die
        Ueberschrift bei jedem Punktestand woanders staende als der Ring.
    -->
    <dimen name="leaderboard_score_column">92dp</dimen>

    <!-- Medaillen im Profil -->
    <dimen name="medal_size">56dp</dimen>
    <dimen name="medal_label_width">78dp</dimen>
</resources>
