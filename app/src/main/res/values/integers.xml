<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Muss mit DisplayName.MAX_LENGTH uebereinstimmen. Ein Layout kann keine
        Kotlin-Konstante lesen, deshalb steht die Zahl hier ein zweites Mal -
        einmal als Eingabegrenze und einmal fuer den Zaehler unter dem Feld.
    -->
    <integer name="display_name_max_length">12</integer>

    <!-- Spalten im Medaillenraster; auf dem Tablet passen mehr nebeneinander. -->
    <integer name="medal_columns">4</integer>

    <!-- Spalten im Auswahlraster fuer das Bild der Nummer eins. Weniger als bei
         den Medaillen: hier muss man erkennen, was auf dem Bild steht. -->
    <integer name="meme_preset_columns">2</integer>
</resources>
