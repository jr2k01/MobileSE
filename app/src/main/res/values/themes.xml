<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme nach Material Design 3.

    Vorher lag hier Theme.MaterialComponents (Material 2) mit einer Handvoll
    Farben. Material 3 bringt das vollstaendige Rollensystem mit, dazu die
    aktuelle Typo-Skala und weichere Formen - Komponenten sehen damit von
    selbst zeitgemaess aus, statt in jedem Layout einzeln zurechtgebogen zu
    werden.

    Die App bleibt durchgehend dunkel, deshalb Theme.Material3.Dark statt
    DayNight. Das war schon die bisherige Absicht ("forced to Dark Mode") und
    passt zu einer Sport-App fuer den Abend.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MobileSE" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Farbrollen -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>

        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>

        <!-- Systemleisten fliessen in den Bildschirm ueber -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_surface_container</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/md_surface</item>

        <!-- Formen und Komponentenstile -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.CrewFit.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.CrewFit.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.CrewFit.Large</item>

        <item name="materialCardViewStyle">@style/Widget.CrewFit.Card</item>
        <item name="materialButtonStyle">@style/Widget.CrewFit.Button</item>
        <item name="textInputStyle">@style/Widget.CrewFit.TextField</item>
        <item name="bottomNavigationStyle">@style/Widget.CrewFit.BottomNav</item>

        <!--
            Auswahlfenster. Ohne diesen Eintrag zeichnet AppCompat seine
            eigenen, eckigen Dialoge in Grau - unabhaengig davon, wie der Rest
            der App aussieht.
        -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CrewFit.Dialog</item>
    </style>

    <style name="Theme.MobileSE" parent="Base.Theme.MobileSE" />

    <!-- === Formen === -->

    <style name="ShapeAppearance.CrewFit.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.CrewFit.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.CrewFit.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- === Auswahlfenster === -->

    <!--
        Dialoge in Material 3: kraeftig abgerundet, auf einer abgesetzten
        Flaeche statt auf Grau, mit der Typo-Skala der App. Die Schaltflaechen
        unten sind Textschaltflaechen, wie M3 es vorsieht.
    -->
    <style name="ThemeOverlay.CrewFit.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.CrewFit</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.CrewFit.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.CrewFit.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CrewFit.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CrewFit.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.CrewFit.Dialog.Button</item>
        <item name="colorSurface">@color/md_surface_container_high</item>
        <item name="android:windowMinWidthMajor">70%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="MaterialAlertDialog.CrewFit" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.CrewFit.Large</item>
        <item name="backgroundTint">@color/md_surface_container_high</item>
    </style>

    <style name="MaterialAlertDialog.CrewFit.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="MaterialAlertDialog.CrewFit.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="Widget.CrewFit.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!--
        Der Kalender fuer das Geburtsdatum bekommt hier bewusst kein Theme
        mehr. Er lief kurzzeitig ueber android:datePickerDialogTheme mit einem
        ThemeOverlay fuer MaterialAlertDialog - das ist fuer den System-Dialog
        das falsche Theme, und der darin gesetzte durchsichtige
        windowBackground machte den Kalender auf echten Geraeten unsichtbar und
        unbedienbar. Verwendet wird jetzt MaterialDatePicker, der sich aus dem
        App-Theme selbst bedient.
    -->

    <!-- Eine Zeile im Sportart-Auswahlfenster -->
    <style name="TextAppearance.CrewFit.DialogItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!-- === Komponenten === -->

    <!--
        Karten ohne Schlagschatten, dafuer mit abgesetzter Flaeche. Das ist
        die in Material 3 uebliche Art, Ebenen zu zeigen, und wirkt ruhiger
        als Schatten auf dunklem Grund.
    -->
    <style name="Widget.CrewFit.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md_surface_container</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CrewFit.Medium</item>
    </style>

    <style name="Widget.CrewFit.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/md_surface_container_low</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/md_outline_variant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CrewFit.Medium</item>
    </style>

    <!-- Gefuellte Schaltflaeche in voller Hoehe, wie sie M3 vorsieht -->
    <style name="Widget.CrewFit.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.CrewFit.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.CrewFit.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.CrewFit.Button.Text" parent="Widget.Material3.Button.TextButton" />

    <style name="Widget.CrewFit.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/md_on_surface_variant</item>
    </style>

    <style name="Widget.CrewFit.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!--
        Die Leiste wechselt keine Reiter, sondern startet fuenf eigene
        Bildschirme - der Startbildschirm selbst steht nicht darin. Deshalb
        ohne aktiven Marker und mit einheitlicher Farbe: sonst erschiene
        dauerhaft ein Eintrag als "hier bist du gerade", was nie stimmt.
    -->
    <style name="Widget.CrewFit.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/md_surface_container</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CrewFit.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/md_on_surface_variant</item>
        <item name="itemTextColor">@color/md_on_surface_variant</item>
        <item name="itemRippleColor">@color/md_primary</item>
    </style>

    <style name="Widget.CrewFit.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!--
        Auf dem Tablet steht die Navigation als senkrechte Schiene am Rand
        statt als Leiste unten. Gleiche Farbgebung, gleiche Ueberlegung zum
        aktiven Marker wie bei der Leiste.
    -->
    <style name="Widget.CrewFit.NavRail" parent="Widget.Material3.NavigationRailView">
        <item name="backgroundTint">@color/md_surface_container</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CrewFit.NavRail.Indicator</item>
        <item name="itemIconTint">@color/md_on_surface_variant</item>
        <item name="itemTextColor">@color/md_on_surface_variant</item>
    </style>

    <style name="Widget.CrewFit.NavRail.Indicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!--
        Die Inhaltsspalte eines Bildschirms.

        Auf dem Telefon nimmt sie die volle Breite ein, auf dem Tablet hoert
        sie bei content_max_width auf und steht mittig. Eine Zeile, die ueber
        die ganze Tablet-Breite laeuft, ist nicht besser lesbar, sondern
        schlechter - der Blick findet den Zeilenanfang nicht wieder.

        Wird in eine ConstraintLayout gelegt, die die volle Breite haelt.
    -->
    <style name="ContentColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/screen_padding_horizontal</item>
        <item name="layout_constraintWidth_max">@dimen/content_max_width</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <!-- Abschnittsueberschrift ueber Listen und Karten -->
    <style name="TextAppearance.CrewFit.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!--
        Eine antippbare Zeile in den Einstellungen.

        Die Mindesthoehe ist kein Schoenheitswert: darunter liegt die Flaeche
        unter dem, was sich mit dem Daumen sicher treffen laesst.
    -->
    <!-- parent="" ist noetig: aus dem Punkt im Namen wuerde Android sonst
         Widget.CrewFit als Elternstil ableiten, und den gibt es nicht. -->
    <style name="Widget.CrewFit.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TextAppearance.CrewFit.SettingsTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.CrewFit.SettingsSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <!-- Eine Zeile der Passwort-Anforderungen unter dem Eingabefeld. -->
    <style name="PasswordRule" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>
</resources>
