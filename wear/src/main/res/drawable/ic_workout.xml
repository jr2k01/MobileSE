<?xml version="1.0" encoding="utf-8"?>
<!--
    Zeichen der Benachrichtigung: eine Stoppuhr, als Umriss aus vollen
    Flaechen - Android faerbt solche Zeichen einfarbig und wirft alles weg, was
    nicht deckend ist. Deshalb eine geschlossene Scheibe mit Krone und kein
    Ring mit Zeiger, der bei dieser Groesse ohnehin verschwaende.

    Von Hand gezeichnet wie die uebrigen Zeichen der App, damit keine weitere
    Symbolbibliothek noetig ist.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Krone -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.2,2h3.6v2.2h-3.6z" />

    <!-- Gehaeuse -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,4.4a8.8,8.8 0,1 0,0.01 0z" />
</vector>
